8:[["$","meta","0",{"charSet":"utf-8"}],["$","title","1",{"children":"Wenode — Own Your Network. Own Your Future."}],["$","meta","2",{"name":"description","content":"Wenode is a sovereign mesh economy platform that lets you create, grow, and monetise your own network. Join the beta or get on the waitlist."}],["$","meta","3",{"property":"og:title","content":"Wenode — Own Your Network. Own Your Future."}],["$","meta","4",{"property":"og:description","content":"The sovereign mesh economy platform."}],["$","meta","5",{"property":"og:url","content":"https://wnode.one"}],["$","meta","6",{"property":"og:type","content":"website"}],["$","meta","7",{"name":"twitter:card","content":"summary"}],["$","meta","8",{"name":"twitter:title","content":"Wenode — Own Your Network. Own Your Future."}],["$","meta","9",{"name":"twitter:description","content":"The sovereign mesh economy platform."}],["$","link","10",{"rel":"icon","href":"/favicon.ico","type":"image/x-icon","sizes":"64x64"}]]
