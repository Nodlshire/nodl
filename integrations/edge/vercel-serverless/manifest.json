{
  "name": "Vercel Serverless Functions",
  "slug": "edge-vercel-serverless",
  "provider": "vercel",
  "service": "serverless",
  "version": "1.0.0",
  "category": "Edge Compute",
  "description": "Vercel Serverless Functions provide compute for Next.js and frontend apps. They bridge frontend events to Wnode backends.",
  "auth": {
    "type": "api-token",
    "fields": [
      "vercel_api_token"
    ]
  },
  "endpoints": [
    {
      "method": "POST",
      "path": "/api/pipeline/invoke",
      "description": "Receive Vercel function payload"
    }
  ],
  "capabilities": [
    "frontend-bridge",
    "api-routes"
  ],
  "docs_url": "https://vercel.com/docs/functions",
  "logo": "logo.svg"
}