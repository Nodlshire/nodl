{
  "android": {
    "min_sdk": 24,
    "target_sdk": 33,
    "abi_list": ["arm64-v8a", "armeabi-v7a", "x86_64"],
    "aar_version": "v0.3.0",
    "battery_constraints": {
      "min_battery_percent": 20,
      "require_charging_for_heavy_compute": true
    },
    "thermal_constraints": {
      "throttle_at_status": "MODERATE",
      "pause_at_status": "SEVERE"
    }
  },
  "pi": {
    "supported_models": ["Raspberry Pi 4 Model B", "Raspberry Pi 5"],
    "thermal_thresholds": {
      "throttle_celsius": 75,
      "halt_celsius": 85
    },
    "ssd_preference": "required_for_heavy_compute",
    "cluster_mode": "enabled"
  },
  "iot": {
    "memory_cap_mb": 64,
    "cpu_quota_percent": 20,
    "ram_only_mode": true,
    "minimal_telemetry": true
  },
  "update_channels": {
    "stable": "https://releases.wnode.one/node-operator/stable/manifest.json",
    "beta": "https://releases.wnode.one/node-operator/beta/manifest.json",
    "nightly": "https://releases.wnode.one/node-operator/nightly/manifest.json"
  }
}
