{
    "name": "wnode-root",
    "version": "1.0.0",
    "packageManager": "npm@10.9.4",
    "private": true,
    "workspaces": [
        "apps/*"
    ],
    "scripts": {
        "dev:all": "concurrently -n \"BACKEND,NODLR,MESH,COMMAND\" -c \"bgBlue,bgGreen,bgMagenta,bgCyan\" \"cd wnoded && go run cmd/wnoded/main.go\" \"cd apps/nodlr && npm run dev\" \"cd apps/mesh && npm run dev\" \"cd apps/command && npm run dev\"",
        "start:all": "./scripts/start-all.sh",
        "test": "echo \"No tests yet\""
    },
    "devDependencies": {
        "concurrently": "^8.2.2"
    },
    "dependencies": {
        "@lighthouse-web3/sdk": "^0.4.5",
        "@noble/ed25519": "^3.1.0",
        "@noble/hashes": "^2.2.0",
        "@types/express": "^5.0.6",
        "ethers": "^6.16.0",
        "express": "^5.2.1",
        "ipfs-car": "^0.9.1",
        "multiformats": "^14.0.0",
        "onnxruntime-node": "^1.25.1"
    }
}
