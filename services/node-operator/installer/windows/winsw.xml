<service>
  <id>nodl-core</id>
  <name>Wnode Operator Core</name>
  <description>Deterministic execution fabric node for the Sovereign Mesh.</description>
  <executable>%BASE%\nodl-core.exe</executable>
  <arguments>--profile=earth --api=https://api.wnode.network</arguments>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
  <onfailure action="restart" delay="5 sec"/>
</service>
