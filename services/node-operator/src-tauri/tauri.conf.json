{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "NODL Operator",
  "version": "0.1.0",
  "identifier": "one.wnode.operator",
  "build": {
    "frontendDist": "../dist-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "NODL Node Operator",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
